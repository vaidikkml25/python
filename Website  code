
from flask import Flask, render_template_string, request, redirect, url_for

app = Flask(__name__)

# Social network graph
graph = {}


def add_user(name):
    graph.setdefault(name, set())


def add_friend(a, b):
    add_user(a)
    add_user(b)
    graph[a].add(b)
    graph[b].add(a)


def mutual_friends(a, b):
    return graph.get(a, set()) & graph.get(b, set())


def recommend(user, top_n=5):
    if user not in graph:
        return []

    scores = {}

    # Find friends of friends using graph traversal
    for friend in graph[user]:
        for fof in graph[friend]:
            if fof != user and fof not in graph[user]:
                scores[fof] = scores.get(fof, 0) + 1

    # Rank by mutual friends
    ranked = sorted(
        scores.items(),
        key=lambda item: (-item[1], item[0].lower())
    )

    return ranked[:top_n]


