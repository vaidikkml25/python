Social Network Friend Recommendation System
Using Graphs and Graph Traversal (BFS)

Users are represented as nodes, friendships as edges.
Friend recommendations are generated by traversing friends-of-friends
and ranking them by number of mutual connections.
"""

# Create social graph (adjacency list using sets)
graph = {}


# Add a user (node) to the graph
def add_user(name):
    graph.setdefault(name, set())


# Add friendship (undirected edge)
def add_friend(a, b):
    add_user(a)
    add_user(b)
    graph[a].add(b)
    graph[b].add(a)


# Find mutual friends of two users
def mutual_friends(u1, u2):
    return graph[u1] & graph[u2]


# Recommend friends using BFS traversal (friends-of-friends)
def recommend(user, top_n=5):
    scores = {}
    for friend in graph[user]:
        for fof in graph[friend]:
            if fof != user and fof not in graph[user]:
                scores[fof] = scores.get(fof, 0) + 1

    # Sort candidates by mutual friend count (highest first)
    ranked = sorted(scores.items(), key=lambda x: -x[1])
    return ranked[:top_n]


