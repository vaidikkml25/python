# ---------- Sample social network ----------
@st.cache_resource
def create_network():
    graph = nx.Graph()

    people = {
        "Aarav": {"age": 21, "interests": ["Python", "AI", "Music"]},
        "Priya": {"age": 22, "interests": ["AI", "Music", "Travel"]},
        "Rohan": {"age": 20, "interests": ["Python", "Gaming", "AI"]},
        "Ananya": {"age": 21, "interests": ["Music", "Travel", "Art"]},
        "Kabir": {"age": 23, "interests": ["Python", "Sports", "Gaming"]},
        "Isha": {"age": 20, "interests": ["AI", "Art", "Music"]},
        "Neha": {"age": 22, "interests": ["Travel", "Reading", "Art"]},
        "Vikram": {"age": 21, "interests": ["Sports", "Python", "Gaming"]},
        "Meera": {"age": 20, "interests": ["Reading", "Music", "AI"]},
        "Arjun": {"age": 23, "interests": ["Sports", "Travel", "Python"]},
    }

    for name, data in people.items():
        graph.add_node(name, **data)

    friendships = [
        ("Aarav", "Priya"), ("Aarav", "Rohan"),
        ("Aarav", "Kabir"), ("Priya", "Ananya"),
        ("Priya", "Isha"), ("Rohan", "Kabir"),
        ("Rohan", "Vikram"), ("Ananya", "Isha"),
        ("Ananya", "Neha"), ("Isha", "Meera"),
        ("Kabir", "Vikram"), ("Neha", "Meera"),
        ("Neha", "Arjun"), ("Meera", "Priya"),
        ("Arjun", "Vikram"), ("Arjun", "Aarav")
    ]

    graph.add_edges_from(friendships)
    return graph

G = create_network()

def recommend_friends(graph, person, method, limit):
    existing = set(graph.neighbors(person))
    existing.add(person)
    candidates = sorted(set(graph.nodes()) - existing)
    scores = {}

    for candidate in candidates:
        mutual = len(
            set(graph.neighbors(person))
            & set(graph.neighbors(candidate))
        )

        if method == "Mutual Friends":
            score = mutual
        elif method == "Jaccard Similarity":
            union = (
                set(graph.neighbors(person))
                | set(graph.neighbors(candidate))
            )
            score = mutual / len(union) if union else 0
        else:
            interests1 = set(graph.nodes[person]["interests"])
            interests2 = set(graph.nodes[candidate]["interests"])
            interest_score = len(interests1 & interests2)
            score = mutual * 2 + interest_score

        scores[candidate] = (score, mutual)

    return sorted(
        scores.items(),
        key=lambda item: (item[1][0], item[1][1]),
        reverse=True
    )[:limit]

