# ---------- Friend recommendations ----------
elif page == "Find Friends":
    st.title("💫 Find Your Next Friend")
    st.write("Select a user and discover people they may know.")

    col1, col2 = st.columns(2)
    with col1:
        person = st.selectbox("Select your profile", sorted(G.nodes()))
    with col2:
        method = st.selectbox(
            "Recommendation algorithm",
            ["Mutual Friends", "Jaccard Similarity",
             "Mutual Friends + Interests"]
        )

    limit = st.slider("Number of recommendations", 1, 8, 5)

    st.caption(
        f"Currently connected to {G.degree(person)} people."
    )

    if st.button("✨ Find Recommendations", type="primary"):
        results = recommend_friends(G, person, method, limit)

        if not results:
            st.warning("No new friends to recommend.")
        else:
            st.subheader(f"People you may know as {person}")

            for name, (score, mutual) in results:
                with st.container():
                    col1, col2, col3 = st.columns([2, 2, 1])
                    with col1:
                        st.markdown(f"### 👤 {name}")
                        interests = G.nodes[name]["interests"]
                        st.caption(" • ".join(interests))
                    with col2:
                        st.write(f"🤝 {mutual} mutual friends")
                        st.write(
                            f"🎯 Recommendation score: {score:.2f}"
                        )
                    with col3:
                        st.write(f"Age: {G.nodes[name]['age']}")

            st.success("Recommendations generated successfully.")

# ---------- Explore network ----------
elif page == "Explore Network":
    st.title("🌐 Explore the Network")

    person = st.selectbox("Choose a person", sorted(G.nodes()))
    neighbors = list(G.neighbors(person))

    c1, c2 = st.columns(2)
    c1.metric("Direct friends", len(neighbors))
    c2.metric("Possible new friends", G.number_of_nodes() - len(neighbors) - 1)

    st.subheader(f"Connections of {person}")
    if neighbors:
        st.write(", ".join(neighbors))

    subgraph_nodes = [person] + neighbors
    subgraph = G.subgraph(subgraph_nodes)

    fig, ax = plt.subplots(figsize=(8, 5))
    pos = nx.spring_layout(subgraph, seed=42)
    nx.draw(
        subgraph, pos, ax=ax, with_labels=True,
        node_color=[
            "#0f9b8e" if n == person else "#818cf8"
            for n in subgraph.nodes()
        ],
        node_size=1400, font_color="white",
        edge_color="#94a3b8"
    )
    ax.axis("off")
    st.pyplot(fig)
    plt.close(fig)

    st.subheader("User directory")
    directory = pd.DataFrame([
        {
            "Name": n,
            "Connections": G.degree(n),
            "Interests": ", ".join(G.nodes[n]["interests"])
        }
        for n in G.nodes()
    ])
    st.dataframe(directory, use_container_width=True)

# ---------- Algorithm lab ----------
elif page == "Algorithm Lab":
    st.title("🧪 Recommendation Algorithm Lab")
    st.write("Compare the results produced by different algorithms.")

    person = st.selectbox("Choose a user", sorted(G.nodes()))
    methods = [
        "Mutual Friends",
        "Jaccard Similarity",
        "Mutual Friends + Interests"
    ]

    comparison = []
    for method_name in methods:
        results = recommend_friends(G, person, method_name, 5)
        for rank, (name, (score, mutual)) in enumerate(results, 1):
            comparison.append({
                "Algorithm": method_name,
                "Rank": rank,
                "Suggested Friend": name,
                "Mutual Friends": mutual,
                "Score": round(score, 3)
            })

    st.dataframe(
        pd.DataFrame(comparison),
        use_container_width=True,
    )

    st.markdown("### How the algorithms work")
    st.markdown("""
    - **Mutual Friends:** ranks users by the number of shared friends.
    - **Jaccard Similarity:** measures overlap between friendship circles.
    - **Mutual Friends + Interests:** combines shared friends and
      shared interests to rank candidates.
    """)

